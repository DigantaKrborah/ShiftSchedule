# Copy to .env and fill in both values.

# ── AI features (Groq — free LLaMA inference) ────────────────────────────────
# Free key from https://console.groq.com → API Keys  (no credit card needed)
GROQ_API_KEY="gsk_..."

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string — e.g. from Neon (https://neon.tech, free tier)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
