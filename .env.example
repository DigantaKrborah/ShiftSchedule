# Copy to .env and set the absolute path to prisma/dev.db on your machine.
# Relative paths (file:./prisma/dev.db) do NOT work with the Next.js Prisma
# client on Windows — use an absolute path.
#
# Example (Windows):
DATABASE_URL="file:E:/ShiftSchedule/prisma/dev.db"
#
# Example (Linux / macOS):
# DATABASE_URL="file:/home/user/ShiftSchedule/prisma/dev.db"
